# IndexLens Environment Configuration

# Gmail API OAuth2 (Phase 0)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Set to 'true' to run offline with synthetic inbox data without requiring credentials.json
MOCK_GMAIL=false

# OpenRouter (Phase 2 LLM Extraction)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage (Phase 1)
DATABASE_URL=sqlite:///./indexlens.db

# Vector Store & Embedding (Phase 4)
CHROMA_PERSIST_DIR=./chroma_db
