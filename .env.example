# IndexLens Environment Configuration — 100% Free Tier Setup
# All services configured here are free of charge.

# ==============================================================================
# Gmail Ingestion (Phase 0 & 1)
# ==============================================================================
# Set MOCK_GMAIL=true to run completely free and offline with synthetic 100-email inbox.
# Set MOCK_GMAIL=false if using your own personal Gmail OAuth2 credentials.json (also free under Google Cloud personal quotas).
MOCK_GMAIL=true
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ==============================================================================
# OpenRouter Free LLM Extraction (Phase 2)
# ==============================================================================
# Get a free API key at https://openrouter.ai/settings/keys (no deposit/card required for :free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary LLM for structured entity extraction (100% FREE on OpenRouter)
# NVIDIA Llama 3.1 Nemotron 70B Instruct — high-accuracy RLHF alignment for structured data
EXTRACTION_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free

# Anomaly detection & complex edge case model (100% FREE)
ANOMALY_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free

# Alternative free model options on OpenRouter:
# - meta-llama/llama-3.3-70b-instruct:free
# - mistralai/mistral-small-24b-instruct-2501:free
# - google/gemini-2.0-flash-exp:free

# ==============================================================================
# Local Storage & Database (Phase 1)
# ==============================================================================
# Local SQLite database (zero cloud cost, zero server dependencies)
DATABASE_URL=sqlite:///./indexlens.db

# ==============================================================================
# Local Vector Store (Phase 4 Semantic Search)
# ==============================================================================
# Runs embedded ChromaDB locally with CPU embeddings (zero API cost)
CHROMA_PERSIST_DIR=./chroma_db
